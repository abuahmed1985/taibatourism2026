# Copy to .env for local runs only. NEVER commit a real .env.
# On Render, set these in Dashboard > Environment instead.
PORT=3000
DB_PATH=./data/taiba.db
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=
ACADEMIC_PASSWORD=
TRAINER_PASSWORD=
# If the three passwords above are empty on first boot, the server generates
# random ones and prints them ONCE in the startup log. Change them afterwards
# from the admin panel (change own password) and set them as env vars.
